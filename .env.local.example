# Supabase — copie este arquivo para .env.local e preencha com os valores do seu projeto
# https://app.supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de service role — APENAS server-side, NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Site URL (para redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
